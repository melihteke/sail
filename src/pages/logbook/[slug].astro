---
import { existsSync } from "node:fs";
import { join } from "node:path";
import type { GetStaticPaths } from "astro";
import { marked } from "marked";
import BaseLayout from "@/layouts/BaseLayout.astro";
import StatCard from "@/components/StatCard.astro";
import WindStrip from "@/components/WindStrip.astro";
import AnalysisCard from "@/components/AnalysisCard.astro";
import MediaGallery from "@/components/MediaGallery.astro";
import SailTrack from "@/components/SailTrack";
import { SITE } from "@/config";
import { SECTION_TITLES, type SailSections } from "@/lib/sections";
import { formatLocal, getSails, type Sail } from "@/lib/sails";
import { formatDuration, formatKn, formatNm } from "@/lib/units";
import { url } from "@/lib/url";

export const getStaticPaths = (async () => {
  const sails = await getSails();
  return sails.map((sail, i) => ({
    params: { slug: sail.slug },
    props: { sail, newer: sails[i - 1], older: sails[i + 1] },
  }));
}) satisfies GetStaticPaths;

interface Props {
  sail: Sail;
  newer?: Sail;
  older?: Sail;
}

const { sail, newer, older } = Astro.props;
const { stats, wind, analysis } = sail;
const date = formatLocal(stats.start, { weekday: "long", day: "numeric", month: "long", year: "numeric" });
const times = `${formatLocal(stats.start, { hour: "2-digit", minute: "2-digit" })}–${formatLocal(stats.end, { hour: "2-digit", minute: "2-digit" })}`;
const details = [
  { label: "Role", value: sail.role[0]!.toUpperCase() + sail.role.slice(1) },
  { label: "Crew", value: sail.crew.length ? sail.crew.join(", ") : "–" },
  { label: "Sails", value: sail.sailsUsed ? `${sail.sailsUsed}${sail.reef ? " (reefed)" : ""}` : sail.reef ? "Reefed" : "–" },
];
const sections = (Object.keys(SECTION_TITLES) as (keyof SailSections)[])
  .filter((key) => sail.sections[key].trim())
  .map((key) => ({ key, title: SECTION_TITLES[key], html: marked.parse(sail.sections[key], { async: false }) as string }));
const mapImage = existsSync(join(process.cwd(), "public", "maps", `${sail.slug}.webp`)) ? url(`/maps/${sail.slug}.webp`) : undefined;
const shareImage = sail.cover?.src ?? mapImage;
const pageUrl = new URL(url(`/logbook/${sail.slug}/`), Astro.site).toString();
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: sail.title,
  description: sail.summary,
  datePublished: stats.start,
  author: { "@type": "Person", name: SITE.author, url: new URL(url("/about"), Astro.site).toString() },
  mainEntityOfPage: pageUrl,
  url: pageUrl,
  ...(shareImage ? { image: new URL(shareImage, Astro.site).toString() } : {}),
  keywords: ["sailing", ...sail.tags].join(", "),
  contentLocation: { "@type": "Place", name: sail.location, geo: { "@type": "GeoCoordinates", latitude: stats.startPoint.lat, longitude: stats.startPoint.lon } },
};
---

<BaseLayout title={sail.title} description={sail.summary} image={shareImage} ogType="article" publishedTime={stats.start} jsonLd={jsonLd}>
  <nav class="text-sm text-muted-foreground" aria-label="Breadcrumb">
    <a href={url("/logbook")} class="hover:text-foreground">Logbook</a>{" / "}<span class="text-foreground">{sail.title}</span>
  </nav>

  <header class="mt-4 max-w-3xl">
    <p class="text-sm text-muted-foreground">{date} · {times} · {sail.location}</p>
    <h1 class="mt-2 text-3xl font-semibold tracking-tight sm:text-4xl">{sail.title}</h1>
    <p class="mt-3 text-lg text-muted-foreground">{sail.summary}</p>
    <div class="mt-4 flex flex-wrap items-center gap-2">
      <span class="text-amber-500" aria-label={`Rated ${sail.rating} out of 5`} title={`Rated ${sail.rating}/5`}>
        {"★".repeat(sail.rating)}<span class="text-muted-foreground/40">{"★".repeat(5 - sail.rating)}</span>
      </span>
      {sail.tags.map((tag) => <span class="rounded-full bg-secondary px-2.5 py-0.5 text-xs font-medium">#{tag}</span>)}
    </div>
  </header>

  <section aria-label="Sail statistics" class="mt-8 grid grid-cols-2 gap-3 md:grid-cols-4">
    <StatCard label="Distance" value={formatNm(stats.distanceNm)} hint="over ground" />
    <StatCard label="Duration" value={formatDuration(stats.elapsedSec)} hint={`${formatDuration(stats.movingSec)} moving`} />
    <StatCard label="Avg speed" value={formatKn(stats.avgSpeedKn)} hint="while moving" />
    <StatCard label="Max speed" value={formatKn(stats.maxSpeedKn)} hint="10 s average" />
  </section>

  <section aria-label="Track and replay" class="mt-6">
    <SailTrack
      client:only="react"
      track={stats.track}
      bounds={stats.bounds}
      startIso={stats.start}
      timeZone={SITE.timeZone}
      maxSpeedKn={stats.maxSpeedKn}
      windHours={wind?.hours ?? []}
      twa={analysis?.twa ?? []}
      maneuvers={analysis?.maneuvers ?? []}
    />
  </section>

  <div class="mt-6 grid gap-6 lg:grid-cols-[minmax(0,1fr)_300px]">
    <div class="min-w-0 space-y-6">
      {wind ? <WindStrip wind={wind} /> : <p class="rounded-2xl border border-border bg-card p-5 text-sm text-muted-foreground">Wind data is not available for this sail.</p>}

      {
        sections.length > 0 && (
          <article class="prose prose-slate max-w-none rounded-2xl border border-border bg-card p-6 shadow-sm dark:prose-invert prose-headings:tracking-tight prose-a:text-primary">
            {sections.map((s) => (
              <section aria-labelledby={`section-${s.key}`}>
                <h2 id={`section-${s.key}`}>{s.title}</h2>
                <Fragment set:html={s.html} />
              </section>
            ))}
          </article>
        )
      }
    </div>

    <aside class="space-y-4">
      {analysis && <AnalysisCard analysis={analysis} />}
      <div class="rounded-2xl border border-border bg-card p-5 shadow-sm">
        <h2 class="text-sm font-semibold">Details</h2>
        <dl class="mt-3 space-y-2 text-sm">
          <div class="flex justify-between gap-3">
            <dt class="text-muted-foreground">Boat</dt>
            <dd class="text-right font-medium">
              {sail.boat ? <a class="text-primary hover:underline" href={url(`/boats/${sail.boat.slug}`)}>{sail.boat.name}</a> : "–"}
            </dd>
          </div>
          {
            details.map((d) => (
              <div class="flex justify-between gap-3">
                <dt class="text-muted-foreground">{d.label}</dt>
                <dd class="text-right font-medium">{d.value}</dd>
              </div>
            ))
          }
        </dl>
        <a
          href={url(`/tracks/${sail.slug}.gpx`)}
          download
          class="mt-4 inline-flex w-full items-center justify-center rounded-lg border border-border px-3 py-2 text-sm font-medium hover:bg-secondary"
        >
          Download GPX
        </a>
      </div>
    </aside>
  </div>

  {sail.media.length > 0 && <MediaGallery items={sail.media} title={sail.title} />}

  <nav class="mt-12 grid gap-4 border-t border-border pt-6 sm:grid-cols-2" aria-label="More sails">
    {
      older ? (
        <a href={url(`/logbook/${older.slug}`)} class="rounded-xl border border-border p-4 hover:bg-secondary">
          <span class="text-xs text-muted-foreground">← Previous sail</span>
          <span class="mt-1 block font-medium">{older.title}</span>
        </a>
      ) : <span></span>
    }
    {
      newer && (
        <a href={url(`/logbook/${newer.slug}`)} class="rounded-xl border border-border p-4 text-right hover:bg-secondary">
          <span class="text-xs text-muted-foreground">Next sail →</span>
          <span class="mt-1 block font-medium">{newer.title}</span>
        </a>
      )
    }
  </nav>
</BaseLayout>
