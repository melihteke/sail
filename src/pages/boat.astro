---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getBoats } from "@/lib/sails";
import { url } from "@/lib/url";

// Old address of the single boat page; send visitors to the main boat.
const boats = await getBoats();
const main = boats.find((b) => b.isDefault) ?? boats[0];
const target = url(main ? `/boats/${main.slug}` : "/boats");
---

<BaseLayout title="The boat">
  <meta http-equiv="refresh" content={`0; url=${target}`} slot="head" />
  <p class="py-16 text-center text-muted-foreground">
    This page has moved to <a class="text-primary underline" href={target}>{target}</a>.
  </p>
</BaseLayout>
