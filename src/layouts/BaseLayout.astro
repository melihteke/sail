---
import "@/styles/global.css";
import { SITE } from "@/config";
import { stripBase, url } from "@/lib/url";
import LangSwitcher from "@/components/LangSwitcher.astro";

interface Props {
  title?: string;
  description?: string;
  /** Social preview image (absolute or site-relative); defaults to /og.png */
  image?: string;
  /** "article" for single sails */
  ogType?: "website" | "article";
  publishedTime?: string;
  /** Structured data (schema.org) for search engines */
  jsonLd?: Record<string, unknown>;
  /** Keep the page out of search engines (admin pages) */
  noindex?: boolean;
}

const { title, description = SITE.description, image, ogType = "website", publishedTime, jsonLd, noindex = false } = Astro.props;
const pageTitle = title ? `${title} · ${SITE.title}` : SITE.title;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(image ?? url("/og.png"), Astro.site);
const path = stripBase(Astro.url.pathname).replace(/\/$/, "") || "/";
const nav = [
  { href: "/", label: "Home", key: "nav.home" },
  { href: "/logbook", label: "Logbook", key: "nav.logbook" },
  { href: "/boats", label: "Boats", key: "nav.boats" },
  { href: "/records", label: "Records", key: "nav.records" },
  { href: "/academy", label: "Sailing Academy", key: "nav.academy" },
  { href: "/about", label: "About", key: "nav.about" },
];
const isActive = (href: string) => (href === "/" ? path === "/" : path.startsWith(href));
const linkClass = (href: string) => [
  "whitespace-nowrap rounded-md px-2.5 py-1.5 transition-colors",
  isActive(href) ? "bg-white/15 font-medium text-white" : "text-sky-100/80 hover:bg-white/10 hover:text-white",
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={SITE.author} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href={url("/favicon.svg")} />
    <link rel="sitemap" href={url("/sitemap-index.xml")} />
    <link rel="alternate" type="application/rss+xml" title={`${SITE.title} · new sails`} href={new URL(url("/rss.xml"), Astro.site)} />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={SITE.title} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content="en_GB" />
    {publishedTime && <meta property="article:published_time" content={publishedTime} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="theme-color" content="#0b3a5c" />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
    <slot name="head" />
    <script is:inline>
      (() => {
        const stored = localStorage.getItem("theme");
        const dark = stored ? stored === "dark" : matchMedia("(prefers-color-scheme: dark)").matches;
        document.documentElement.classList.toggle("dark", dark);
        const lang = localStorage.getItem("lang");
        if (lang === "nl" || lang === "tr") document.documentElement.lang = lang;
        if (!/\/admin(\/|$)/.test(location.pathname)) document.documentElement.classList.add("no-copy");
      })();
    </script>
  </head>
  <body class="flex min-h-screen flex-col font-sans">
    <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[1000] focus:rounded-md focus:bg-background focus:px-3 focus:py-2">Skip to content</a>
    <header class="sticky top-0 z-[500] bg-navy-900 text-white shadow-md">
      <div class="mx-auto flex h-14 max-w-6xl items-center justify-between gap-4 px-4 sm:px-6">
        <a href={url("/")} class="flex shrink-0 items-center gap-2 font-semibold tracking-tight">
          <img src={url("/favicon.svg")} alt="" width="26" height="26" />
          <span>{SITE.title}</span>
        </a>

        <nav aria-label="Main" class="hidden items-center gap-0.5 text-sm lg:flex">
          {
            nav.map((item) => (
              <a href={url(item.href)} aria-current={isActive(item.href) ? "page" : undefined} class:list={linkClass(item.href)} data-i18n={item.key}>
                {item.label}
              </a>
            ))
          }
          <a
            href={url("/admin/")}
            rel="nofollow"
            aria-current={isActive("/admin") ? "page" : undefined}
            class="ml-1 rounded-md border border-white/30 px-2.5 py-1.5 font-medium text-white transition-colors hover:bg-white/10"
            data-i18n="nav.admin"
          >
            Admin
          </a>
          <LangSwitcher id="lang-d" class="ml-2" />
          <button
            data-theme-toggle
            type="button"
            aria-label="Toggle dark mode"
            class="ml-1 flex h-8 w-8 items-center justify-center rounded-md text-sky-100 hover:bg-white/10 hover:text-white"
          >
            <svg class="h-4 w-4 dark:hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z"></path></svg>
            <svg class="hidden h-4 w-4 dark:block" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4"></circle><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path></svg>
          </button>
        </nav>

        <div class="flex items-center gap-1 lg:hidden">
          <LangSwitcher id="lang-m" />
          <button
            data-theme-toggle
            type="button"
            aria-label="Toggle dark mode"
            class="flex h-9 w-9 items-center justify-center rounded-md text-sky-100 hover:bg-white/10 hover:text-white"
          >
            <svg class="h-4 w-4 dark:hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z"></path></svg>
            <svg class="hidden h-4 w-4 dark:block" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4"></circle><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path></svg>
          </button>
          <button
            id="menu-toggle"
            type="button"
            aria-label="Open menu"
            aria-expanded="false"
            aria-controls="mobile-menu"
            class="flex h-9 w-9 items-center justify-center rounded-md text-white hover:bg-white/10"
          >
            <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"></path></svg>
          </button>
        </div>
      </div>
      <nav id="mobile-menu" aria-label="Main" hidden class="border-t border-white/10 bg-navy-900 px-4 py-3 lg:hidden">
        <div class="grid gap-1 text-sm">
          {
            nav.map((item) => (
              <a href={url(item.href)} aria-current={isActive(item.href) ? "page" : undefined} class:list={linkClass(item.href)} data-i18n={item.key}>
                {item.label}
              </a>
            ))
          }
          <a href={url("/admin/")} rel="nofollow" class="mt-1 rounded-md border border-white/30 px-3 py-1.5 font-medium" data-i18n="nav.admin">Admin</a>
        </div>
      </nav>
    </header>

    <main id="main" class="mx-auto w-full max-w-6xl flex-1 px-4 py-8 sm:px-6 sm:py-12">
      <slot />
    </main>

    <footer class="border-t border-border">
      <div class="mx-auto flex max-w-6xl flex-col gap-2 px-4 py-6 text-xs text-muted-foreground sm:flex-row sm:items-start sm:justify-between sm:px-6">
        <p>
          © {new Date().getFullYear()} {SITE.author} · <span data-i18n="footer.fair">Fair winds ⛵</span>{" · "}
          <a class="underline underline-offset-2 hover:text-foreground" href={url("/rss.xml")}>RSS</a>
        </p>
        <p class="sm:max-w-[70%] sm:text-right">
          <span data-i18n="footer.weather">Weather &amp; sea</span> <a class="underline underline-offset-2 hover:text-foreground" href="https://open-meteo.com/">Open-Meteo</a>{" · "}Radar{" "}
          <a class="underline underline-offset-2 hover:text-foreground" href="https://www.rainviewer.com/">RainViewer</a>{" · "}Maps{" "}
          <a class="underline underline-offset-2 hover:text-foreground" href="https://www.openstreetmap.org/copyright">OpenStreetMap</a>{" & "}
          <a class="underline underline-offset-2 hover:text-foreground" href="https://www.openseamap.org">OpenSeaMap</a>
        </p>
      </div>
    </footer>

    <script>
      import { SITE_STRINGS, type SiteKey } from "@/i18n/site";
      import { getLang, isLang, onLangChange, setLang, type Lang } from "@/lib/lang";

      document.querySelectorAll("[data-theme-toggle]").forEach((button) =>
        button.addEventListener("click", () => {
          const dark = document.documentElement.classList.toggle("dark");
          localStorage.setItem("theme", dark ? "dark" : "light");
        }),
      );
      const toggle = document.getElementById("menu-toggle");
      const menu = document.getElementById("mobile-menu");
      toggle?.addEventListener("click", () => {
        const open = menu!.hidden;
        menu!.hidden = !open;
        toggle.setAttribute("aria-expanded", String(open));
        toggle.setAttribute("aria-label", open ? "Close menu" : "Open menu");
      });

      const applyLang = (lang: Lang) => {
        const dict = SITE_STRINGS[lang];
        document.documentElement.lang = lang;
        document.querySelectorAll<HTMLElement>("[data-i18n]").forEach((el) => {
          const text = dict[el.dataset.i18n as SiteKey];
          if (text) el.textContent = text;
        });
        document.querySelectorAll<HTMLElement>("[data-i18n-aria]").forEach((el) => {
          const text = dict[el.dataset.i18nAria as SiteKey];
          if (text) el.setAttribute("aria-label", text);
        });
        document.querySelectorAll("[data-lang]").forEach((b) =>
          b.setAttribute("aria-pressed", String(b.getAttribute("data-lang") === lang)),
        );
      };
      if (getLang() !== "en") applyLang(getLang());
      onLangChange(applyLang);
      document.querySelectorAll<HTMLElement>("[data-lang]").forEach((b) =>
        b.addEventListener("click", () => {
          const lang = b.dataset.lang;
          if (isLang(lang)) setLang(lang);
          closeLangMenus();
        }),
      );

      // Language dropdown: one flag button opens the list; outside click or Escape closes it.
      const langMenus = [...document.querySelectorAll<HTMLElement>("[data-lang-menu]")];
      const closeLangMenus = (except?: HTMLElement) =>
        langMenus.forEach((m) => {
          if (m === except) return;
          m.querySelector<HTMLElement>("[data-lang-list]")!.hidden = true;
          m.querySelector("[data-lang-toggle]")!.setAttribute("aria-expanded", "false");
        });
      langMenus.forEach((m) => {
        const toggle = m.querySelector<HTMLElement>("[data-lang-toggle]")!;
        const list = m.querySelector<HTMLElement>("[data-lang-list]")!;
        toggle.addEventListener("click", () => {
          const open = list.hidden;
          closeLangMenus(m);
          list.hidden = !open;
          toggle.setAttribute("aria-expanded", String(open));
          if (open) list.querySelector<HTMLElement>("[aria-pressed='true']")?.focus();
        });
      });
      document.addEventListener("click", (e) => {
        if (!(e.target instanceof Element) || !e.target.closest("[data-lang-menu]")) closeLangMenus();
      });
      document.addEventListener("keydown", (e) => {
        if (e.key === "Escape") closeLangMenus();
      });

      // Copy deterrent for public pages: GitHub Pages can't enforce this server-side, so it only discourages casual copying.
      if (document.documentElement.classList.contains("no-copy")) {
        const editable = (t: EventTarget | null) =>
          t instanceof Element && !!t.closest("input, textarea, select, [contenteditable='true']");
        for (const type of ["contextmenu", "copy", "cut", "dragstart", "selectstart"]) {
          document.addEventListener(type, (e) => {
            if (editable(e.target)) return;
            // Interactive drag-and-drop (academy planners) stays usable.
            if (type === "dragstart" && e.target instanceof Element && e.target.closest("[draggable='true']")) return;
            e.preventDefault();
          });
        }
        document.addEventListener("keydown", (e) => {
          if (!(e.ctrlKey || e.metaKey) || editable(e.target)) return;
          if (["c", "x", "s", "u", "a", "p"].includes(e.key.toLowerCase())) e.preventDefault();
        });
      }    </script>
  </body>
</html>
