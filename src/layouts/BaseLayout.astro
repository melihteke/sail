---
import "@/styles/global.css";
import { SITE } from "@/config";
import { stripBase, url } from "@/lib/url";

interface Props {
  title?: string;
  description?: string;
  /** Social preview image (absolute or site-relative); defaults to /og.png */
  image?: string;
  /** "article" for single sails */
  ogType?: "website" | "article";
  publishedTime?: string;
  /** Structured data (schema.org) for search engines */
  jsonLd?: Record<string, unknown>;
  /** Keep the page out of search engines (admin pages) */
  noindex?: boolean;
}

const { title, description = SITE.description, image, ogType = "website", publishedTime, jsonLd, noindex = false } = Astro.props;
const pageTitle = title ? `${title} · ${SITE.title}` : SITE.title;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(image ?? url("/og.png"), Astro.site);
const path = stripBase(Astro.url.pathname).replace(/\/$/, "") || "/";
const nav = [
  { href: "/", label: "Home" },
  { href: "/logbook", label: "Logbook" },
  { href: "/boats", label: "Boats" },
  { href: "/records", label: "Records" },
  { href: "/about", label: "About" },
];
const isActive = (href: string) => (href === "/" ? path === "/" : path.startsWith(href));
const linkClass = (href: string) => [
  "rounded-md px-3 py-1.5 transition-colors",
  isActive(href) ? "bg-secondary font-medium text-foreground" : "text-muted-foreground hover:text-foreground",
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={SITE.author} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href={url("/favicon.svg")} />
    <link rel="sitemap" href={url("/sitemap-index.xml")} />
    <link rel="alternate" type="application/rss+xml" title={`${SITE.title} · new sails`} href={new URL(url("/rss.xml"), Astro.site)} />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={SITE.title} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content="en_GB" />
    {publishedTime && <meta property="article:published_time" content={publishedTime} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="theme-color" content="#0b3a5c" />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
    <slot name="head" />
    <script is:inline>
      (() => {
        const stored = localStorage.getItem("theme");
        const dark = stored ? stored === "dark" : matchMedia("(prefers-color-scheme: dark)").matches;
        document.documentElement.classList.toggle("dark", dark);
      })();
    </script>
  </head>
  <body class="min-h-screen font-sans">
    <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[1000] focus:rounded-md focus:bg-background focus:px-3 focus:py-2">Skip to content</a>
    <header class="sticky top-0 z-[500] border-b border-border bg-background/85 backdrop-blur">
      <div class="mx-auto flex h-14 max-w-6xl items-center justify-between gap-4 px-4 sm:px-6">
        <a href={url("/")} class="flex items-center gap-2 font-semibold tracking-tight">
          <img src={url("/favicon.svg")} alt="" width="26" height="26" />
          <span>{SITE.title}</span>
        </a>

        <nav aria-label="Main" class="hidden items-center gap-1 text-sm md:flex">
          {
            nav.map((item) => (
              <a href={url(item.href)} aria-current={isActive(item.href) ? "page" : undefined} class:list={linkClass(item.href)}>
                {item.label}
              </a>
            ))
          }
          <a
            href={url("/admin/")}
            rel="nofollow"
            aria-current={isActive("/admin") ? "page" : undefined}
            class="ml-1 rounded-md border border-border px-3 py-1.5 font-medium text-foreground transition-colors hover:bg-secondary"
          >
            Admin
          </a>
          <button
            data-theme-toggle
            type="button"
            aria-label="Toggle dark mode"
            class="ml-1 flex h-8 w-8 items-center justify-center rounded-md text-muted-foreground hover:bg-secondary hover:text-foreground"
          >
            <svg class="h-4 w-4 dark:hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z"></path></svg>
            <svg class="hidden h-4 w-4 dark:block" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4"></circle><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path></svg>
          </button>
        </nav>

        <div class="flex items-center gap-1 md:hidden">
          <button
            data-theme-toggle
            type="button"
            aria-label="Toggle dark mode"
            class="flex h-9 w-9 items-center justify-center rounded-md text-muted-foreground hover:bg-secondary hover:text-foreground"
          >
            <svg class="h-4 w-4 dark:hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z"></path></svg>
            <svg class="hidden h-4 w-4 dark:block" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4"></circle><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path></svg>
          </button>
          <button
            id="menu-toggle"
            type="button"
            aria-label="Open menu"
            aria-expanded="false"
            aria-controls="mobile-menu"
            class="flex h-9 w-9 items-center justify-center rounded-md text-foreground hover:bg-secondary"
          >
            <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"></path></svg>
          </button>
        </div>
      </div>
      <nav id="mobile-menu" aria-label="Main" hidden class="border-t border-border bg-background px-4 py-3 md:hidden">
        <div class="grid gap-1 text-sm">
          {
            nav.map((item) => (
              <a href={url(item.href)} aria-current={isActive(item.href) ? "page" : undefined} class:list={linkClass(item.href)}>
                {item.label}
              </a>
            ))
          }
          <a href={url("/admin/")} rel="nofollow" class="mt-1 rounded-md border border-border px-3 py-1.5 font-medium">Admin</a>
        </div>
      </nav>
    </header>

    <main id="main" class="mx-auto max-w-6xl px-4 py-8 sm:px-6 sm:py-12">
      <slot />
    </main>

    <footer class="border-t border-border">
      <div class="mx-auto flex max-w-6xl flex-col gap-2 px-4 py-6 text-xs text-muted-foreground sm:flex-row sm:items-start sm:justify-between sm:px-6">
        <p>
          © {new Date().getFullYear()} {SITE.author} · Fair winds ⛵{" · "}
          <a class="underline underline-offset-2 hover:text-foreground" href={url("/rss.xml")}>RSS</a>
        </p>
        <p class="sm:max-w-[70%] sm:text-right">
          Weather &amp; sea <a class="underline underline-offset-2 hover:text-foreground" href="https://open-meteo.com/">Open-Meteo</a>{" · "}Radar{" "}
          <a class="underline underline-offset-2 hover:text-foreground" href="https://www.rainviewer.com/">RainViewer</a>{" · "}Maps{" "}
          <a class="underline underline-offset-2 hover:text-foreground" href="https://www.openstreetmap.org/copyright">OpenStreetMap</a>{" & "}
          <a class="underline underline-offset-2 hover:text-foreground" href="https://www.openseamap.org">OpenSeaMap</a>{" · "}
          <a class="underline underline-offset-2 hover:text-foreground" href={SITE.github}>Source</a>
        </p>
      </div>
    </footer>

    <script>
      document.querySelectorAll("[data-theme-toggle]").forEach((button) =>
        button.addEventListener("click", () => {
          const dark = document.documentElement.classList.toggle("dark");
          localStorage.setItem("theme", dark ? "dark" : "light");
        }),
      );
      const toggle = document.getElementById("menu-toggle");
      const menu = document.getElementById("mobile-menu");
      toggle?.addEventListener("click", () => {
        const open = menu!.hidden;
        menu!.hidden = !open;
        toggle.setAttribute("aria-expanded", String(open));
        toggle.setAttribute("aria-label", open ? "Close menu" : "Open menu");
      });
    </script>
  </body>
</html>
