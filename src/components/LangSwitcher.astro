---
import Flag from "@/components/Flag.astro";
import { LANGS } from "@/lib/lang";

interface Props {
  /** Unique prefix for element ids when the switcher is rendered more than once */
  id: string;
  class?: string;
}
const { id, class: className } = Astro.props;
---

<!-- One flag (the current language); the others appear in a small dropdown. -->
<div data-lang-menu class:list={["relative", className]}>
  <button
    type="button"
    data-lang-toggle
    aria-haspopup="true"
    aria-expanded="false"
    aria-controls={`${id}-list`}
    aria-label="Language"
    data-i18n-aria="ui.language"
    class="flex h-8 items-center gap-1 rounded-md px-1.5 text-sky-100 transition hover:bg-white/10 hover:text-white"
  >
    {LANGS.map((l) => <span data-flag={l.code} class="lang-flag"><Flag code={l.code} id={`${id}-cur-${l.code}`} /></span>)}
    <svg class="h-3 w-3 opacity-80" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="m3 4.5 3 3 3-3"></path></svg>
  </button>
  <ul
    id={`${id}-list`}
    data-lang-list
    hidden
    class="absolute right-0 top-full z-[600] mt-1 min-w-40 overflow-hidden rounded-lg border border-border bg-popover py-1 text-sm text-popover-foreground shadow-lg"
  >
    {
      LANGS.map((l) => (
        <li>
          <button
            type="button"
            data-lang={l.code}
            aria-pressed={l.code === "en" ? "true" : "false"}
            class="flex w-full items-center gap-2.5 px-3 py-2 text-left hover:bg-secondary aria-pressed:font-semibold"
          >
            <Flag code={l.code} id={`${id}-opt-${l.code}`} />
            {l.label}
          </button>
        </li>
      ))
    }
  </ul>
</div>
