---
interface Props {
  label: string;
  value: string;
  hint?: string;
  /** Translation key for the label (see src/i18n/site.ts) */
  i18n?: string;
}
const { label, value, hint, i18n } = Astro.props;
---

<div class="min-w-0 rounded-xl border border-border bg-card p-4 shadow-sm">
  <p class="text-[11px] font-medium uppercase tracking-wider text-muted-foreground" data-i18n={i18n}>{label}</p>
  <p class="mt-1 truncate text-2xl font-semibold tabular-nums tracking-tight" title={value}>{value}</p>
  {hint && <p class="mt-0.5 truncate text-xs text-muted-foreground" title={hint}>{hint}</p>}
</div>
