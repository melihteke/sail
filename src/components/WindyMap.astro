---
import type { Place } from "@/lib/settings";

interface Props {
  place: Place;
}

// Centre, zoom and title come from the admin settings ("Live wind map"). The build bakes in the
// value known at build time; the script below swaps in the live value so changes show without a deploy.
// Narrow screens use one zoom level less so the area still fits (Windy only takes whole zooms).
const { place } = Astro.props;
const zoom = place.zoom ?? 8;
---

<section aria-labelledby="windy-map" class="mt-6 overflow-hidden rounded-2xl border border-border bg-card shadow-sm">
  <div class="flex flex-wrap items-end justify-between gap-2 px-5 pt-5">
    <div>
      <p class="text-[10px] font-medium uppercase tracking-[0.16em] text-muted-foreground">Live wind map</p>
      <h2 id="windy-map" class="mt-1.5 text-xl font-semibold tracking-tight">Wind over <span data-windy-name>{place.name}</span></h2>
    </div>
    <p class="text-xs text-muted-foreground">
      Knots · ECMWF model · <a data-windy-link class="underline underline-offset-2 hover:text-foreground" href={`https://www.windy.com/?${place.lat},${place.lon},${zoom}`} target="_blank" rel="noopener">Source: Windy.com</a>
    </p>
  </div>
  <div
    class="relative mt-4 h-[460px] w-full bg-[#2a3b4d] sm:h-[560px]"
    data-windy
    data-lat={place.lat}
    data-lon={place.lon}
    data-zoom={zoom}
    data-name={place.name}
  >
    <iframe
      title={`Live wind map by Windy.com`}
      loading="lazy"
      class="absolute inset-0 h-full w-full border-0"
      referrerpolicy="strict-origin-when-cross-origin"
      allowfullscreen></iframe>
    <!-- Lets the page scroll past the map; one tap/click hands control to the map. -->
    <button
      type="button"
      data-windy-shield
      class="group absolute inset-0 flex items-end justify-center bg-transparent pb-4 focus-visible:outline-none"
      aria-label="Interact with the wind map"
    >
      <span class="rounded-full bg-black/55 px-3 py-1.5 text-xs font-medium text-white opacity-0 backdrop-blur-sm transition group-hover:opacity-100 group-focus-visible:opacity-100">
        Click to explore the map
      </span>
    </button>
  </div>
</section>

<script>
  import { fetchSettings, type Place } from "@/lib/settings";

  const embed = (p: Place, z: number) => {
    const params = new URLSearchParams({
      type: "map",
      location: "coordinates",
      lat: String(p.lat),
      lon: String(p.lon),
      zoom: String(z),
      level: "surface",
      overlay: "wind",
      product: "ecmwf",
      calendar: "now",
      pressure: "",
      menu: "",
      message: "true",
      marker: "",
      metricWind: "kt",
      metricTemp: "°C",
      radarRange: "-1",
    });
    return `https://embed.windy.com/embed.html?${params}`;
  };

  document.querySelectorAll<HTMLElement>("[data-windy]").forEach((box) => {
    const section = box.closest("section");
    const frame = box.querySelector<HTMLIFrameElement>("iframe");
    const show = (p: Place) => {
      const zoom = p.zoom ?? 8;
      const src = embed(p, box.clientWidth < 640 ? zoom - 1 : zoom);
      if (frame && frame.src !== src) frame.src = src;
      section?.querySelectorAll("[data-windy-name]").forEach((el) => (el.textContent = p.name));
      section?.querySelector<HTMLAnchorElement>("[data-windy-link]")?.setAttribute("href", `https://www.windy.com/?${p.lat},${p.lon},${zoom}`);
    };
    const d = box.dataset;
    const baked: Place = { name: d.name ?? "", lat: Number(d.lat), lon: Number(d.lon), zoom: Number(d.zoom) };
    show(baked);
    void fetchSettings().then((s) => {
      const w = s.wind_map;
      if (w.lat !== baked.lat || w.lon !== baked.lon || (w.zoom ?? 8) !== baked.zoom || w.name !== baked.name) show(w);
    });
    const shield = box.querySelector<HTMLButtonElement>("[data-windy-shield]");
    shield?.addEventListener("click", () => shield.remove());
  });
</script>
