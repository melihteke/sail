---
import type { WindSummary } from "@/lib/wind";
import { formatLocal } from "@/lib/sails";
import { beaufort, compass } from "@/lib/units";

interface Props {
  wind: WindSummary;
}
const { wind } = Astro.props;
const max = Math.max(10, ...wind.hours.map((h) => h.gustKn));
const bft = beaufort(wind.avgKn);
---

<div class="rounded-2xl border border-border bg-card p-5 shadow-sm">
  <div class="flex flex-wrap items-baseline justify-between gap-2">
    <h2 class="text-base font-semibold tracking-tight">Wind during the sail</h2>
    <p class="text-xs text-muted-foreground">Hourly model data at 10 m · {wind.source}</p>
  </div>
  <div class="mt-3 flex flex-wrap gap-2 text-xs">
    <span class="rounded-full bg-sea/15 px-2.5 py-1 font-semibold text-sea">Bft {bft.force} · {bft.name}</span>
    <span class="rounded-full bg-secondary px-2.5 py-1 font-medium">Avg {wind.avgKn.toFixed(1)} kn</span>
    <span class="rounded-full bg-secondary px-2.5 py-1 font-medium">Gusts up to {wind.maxGustKn.toFixed(0)} kn</span>
    <span class="rounded-full bg-secondary px-2.5 py-1 font-medium">From {compass(wind.dirDeg)} ({Math.round(wind.dirDeg)}°)</span>
    <span class="rounded-full bg-secondary px-2.5 py-1 font-medium">{wind.tempC.toFixed(0)} °C</span>
  </div>
  <div class="mt-5 flex items-end gap-2 overflow-x-auto pb-1" role="list" aria-label="Hourly wind">
    {
      wind.hours.map((h) => (
        <div role="listitem" class="flex min-w-[44px] flex-1 flex-col items-center gap-1 text-center">
          <span class="text-[11px] font-semibold tabular-nums">{h.speedKn.toFixed(0)}</span>
          <div class="relative flex h-24 w-5 items-end overflow-hidden rounded-md bg-muted" title={`${h.speedKn.toFixed(1)} kn, gusts ${h.gustKn.toFixed(1)} kn from ${compass(h.dirDeg)}`}>
            <div class="absolute bottom-0 w-full bg-sea/25" style={`height:${(h.gustKn / max) * 100}%`}></div>
            <div class="relative w-full rounded-t-sm bg-sea" style={`height:${(h.speedKn / max) * 100}%`}></div>
          </div>
          <svg viewBox="0 0 24 24" class="h-4 w-4 text-sea" style={`transform:rotate(${(h.dirDeg + 180) % 360}deg)`} aria-hidden="true">
            <path d="M12 2 L19 20 L12 16 L5 20 Z" fill="currentColor"></path>
          </svg>
          <span class="text-[10px] text-muted-foreground">{compass(h.dirDeg)}</span>
          <span class="text-[10px] tabular-nums text-muted-foreground">{formatLocal(h.time, { hour: "2-digit", minute: "2-digit" })}</span>
        </div>
      ))
    }
  </div>
  <p class="mt-3 text-[11px] text-muted-foreground">Solid bar: mean wind, light bar: gusts (kn). Arrows point where the wind blows to.</p>
</div>
